# Neon Database (Serverless PostgreSQL)
# Pooled connection string used by the Next.js runtime
DATABASE_URL="postgresql://username:password@ep-example-pooler.us-east-2.aws.neon.tech/fashionart?sslmode=require"
# Unpooled direct connection string used by drizzle-kit migrations
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-example.us-east-2.aws.neon.tech/fashionart?sslmode=require"

# Clerk Authentication (Next.js)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key"
CLERK_SECRET_KEY="your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# Cloudinary (Media & Image Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend (Email Service for Enquiries)
RESEND_API_KEY="your_resend_api_key"
RESEND_ADMIN_EMAIL="fashionartcbe@gmail.com"

# Google Sheets Webhook / API (Enquiry Form & Doll Contest Voting Sync)
